REMEMBER fact "Procurement accepts 36-month terms" CONCEPTS "Renewal", "Procurement" LINK TO q140 WEIGHT 0.8 FIELDS (source = 'call') AS F;
LINK $F TO g201 WEIGHT 0.7;
SUPERSEDE q140 WITH $F;
CONCEPT "Churn risk" MEMBERS g203 RELATED "Renewal" AS C;
INSERT INTO deal (text, account, stage, value) VALUES ('Telematics upsell', 'Ostrava Logistics', 'proposal', 12500), ('Corrin expansion', 'Corrin Confectionery', 'lead', 5000);
UPDATE memory SET fields.stage = 'won' WHERE id = g201;
UPDATE memory SET fields.owner = 'Kim' WHERE kind = deal DRY RUN;
BOOST d121, g201;
WEAKEN n150;
PIN d121;
UNPIN d121;
FOCUS d121, $F;
FOCUS ADD g202;
FOCUS REMOVE g202;
GOAL "Win Halvorsen" FOCUS d121;
CONNECTOR alias "ACV" TERMS 'annual contract value' AS A;
CONNECTOR hub "Q4 renewals" CONNECT g201, g203, d121 AS H;
CONNECT t130 TO $H;
DISCONNECT t130 FROM $H;
KIND ADD customer COLOR '#ff8787' HALF LIFE 90 BASE 0.7 PREFIX u SECTION customers;
REMEMBER customer "Halvorsen Freight AS" FIELDS (account = 'Halvorsen Freight');
RESOLVE account BY fields.account MIN 2;
RESOLVE email DRY RUN;
FORGET WHERE kind = note DRY RUN;
FORGET n150;
SELECT id, fields.stage FROM memory WHERE kind = deal ORDER BY id;
SELECT id, type, label, key, degree FROM connectors ORDER BY id;
SELECT id FROM memory WHERE route = 'H:q4-renewals' ORDER BY id;
