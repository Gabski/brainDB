SHOW kinds;
SHOW sections;
SELECT id, kind, weight FROM memory WHERE kind IN (deal, task) ORDER BY id;
SELECT id, fields.account, fields.value FROM memory WHERE kind = deal AND fields.value > 10000 ORDER BY fields.value DESC;
SELECT id FROM memory WHERE fields.value BETWEEN 9000 AND 13000 ORDER BY id;
SELECT fields.stage, COUNT(*), SUM(fields.value), AVG(fields.value), MIN(fields.value), MAX(fields.value) FROM memory WHERE kind = deal GROUP BY fields.stage ORDER BY fields.stage;
SELECT id, text FROM memory WHERE text ~ 'renewal' AND NOT superseded AND lit ORDER BY id;
SELECT id FROM memory WHERE concept = 'Pricing' ORDER BY id;
SELECT id FROM memory WHERE (kind = note OR kind = question) AND age <= 3 ORDER BY id;
SELECT id, fields.* FROM memory WHERE kind = deal ORDER BY id LIMIT 2 OFFSET 1;
SELECT id, text FROM memory WHERE HAS email ORDER BY id;
SELECT id FROM memory WHERE entities.date <= '2026-12-31' ORDER BY id;
SELECT id FROM memory WHERE entities.money > 'EUR 100' ORDER BY id;
SELECT type, value, COUNT(*) FROM entities WHERE type = email GROUP BY value;
SELECT id, text FROM memory NEAR "multi-year discount" LIMIT 3;
SELECT a, b, w, type FROM links WHERE type = assoc ORDER BY a, b;
SELECT id, text, degree FROM concepts ORDER BY id;
SEARCH "renewal discount" MODE hybrid LIMIT 3;
SEARCH "renewal discount" MODE vector LIMIT 3;
SEARCH "renewal discount" MODE graph LIMIT 3;
QUERY 'kind:deal stage=negotiation sort:-value select:id,fields.value';
INSPECT d121 WITH item, links;
PATHS FROM t130 TO f102 LIMIT 2;
EXTRACT FROM "Call Kim Aalto (+47 22 33 44 55) before 15 Dec 2026 about €48k";
EXTRACT f101;
EXPLAIN SELECT * FROM memory WHERE fields.stage = 'won';
LET $top = (SELECT id FROM memory WHERE kind = deal ORDER BY fields.value DESC LIMIT 1);
INSPECT $top WITH item;
