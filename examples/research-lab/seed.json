    {"id": "f101", "kind": "fact", "section": "facts", "text": "Baseline electrolyte EL-0: 1.0 M NaPF6 in EC:DEC 1:1 by volume, water below 20 ppm", "concepts": ["electrolyte"], "ageDays": 50, "pinned": true, "base": 0.85},
    {"id": "f102", "kind": "fact", "section": "facts", "text": "EL-7 is EL-0 plus 2 wt% FEC and 0.5 wt% TMSB", "concepts": ["additive", "electrolyte"], "ageDays": 30},
    {"id": "f103", "kind": "fact", "section": "facts", "text": "Cell format: hard carbon HC-3 anode against NVPF cathode in CR2032 coin cells, 2 mAh/cm2 loading", "concepts": ["cells"], "ageDays": 40},
    {"id": "f104", "kind": "fact", "section": "facts", "text": "EL-7 retains 91.4% capacity after 200 cycles at C/2 and 25 °C versus 82.1% for EL-0 (n=6 each, RUN-2611)", "concepts": ["cycling", "additive"], "ageDays": 4, "labels": ["ip-sensitive"]},
    {"id": "f105", "kind": "fact", "section": "facts", "text": "First-cycle Coulombic efficiency: EL-7 86.2%, EL-0 83.5%", "concepts": ["sei", "cycling"], "ageDays": 9, "labels": ["ip-sensitive"]},
    {"id": "f106", "kind": "fact", "section": "facts", "text": "Pouch cell gas volume after formation with EL-7: 0.9 mL (single cell, unverified)", "concepts": ["gassing", "cells"], "ageDays": 28, "supersededBy": "f107"},
    {"id": "f107", "kind": "fact", "section": "facts", "text": "Pouch gas after formation with EL-7: 0.42 ± 0.06 mL (n=4, RUN-2617); the earlier 0.9 mL came from a leaking seal", "concepts": ["gassing", "cells", "stats"], "ageDays": 6, "labels": ["ip-sensitive"]},
    {"id": "f108", "kind": "fact", "section": "facts", "text": "At 45 °C EL-7 fades faster: 84.0% capacity after 150 cycles versus 86.5% for EL-0 (n=4, RUN-2614)", "concepts": ["temperature", "cycling", "additive"], "ageDays": 3, "labels": ["ip-sensitive"]},
    {"id": "f109", "kind": "fact", "section": "facts", "text": "Glovebox on 18 Nov 2026: O2 4 ppm, H2O 0.6 ppm; regeneration due 1 Dec 2026", "concepts": ["instruments", "safety"], "ageDays": 2},
    {"id": "f110", "kind": "fact", "section": "facts", "text": "Karl Fischer titrator recalibrated 10 Nov 2026; EL-7 batch B3 water content 14 ppm", "concepts": ["instruments", "electrolyte"], "ageDays": 10},
    {"id": "f111", "kind": "fact", "section": "facts", "text": "SEI resistance from EIS after 50 cycles: EL-7 38 ohm, EL-0 61 ohm", "concepts": ["impedance", "sei"], "ageDays": 7, "labels": ["ip-sensitive"]},
    {"id": "f112", "kind": "fact", "section": "facts", "text": "Ionic conductivity at 25 °C: EL-0 8.9 mS/cm, EL-7 8.6 mS/cm; at 45 °C EL-7 reaches 12.1 mS/cm", "concepts": ["electrolyte", "temperature"], "ageDays": 8, "labels": ["ip-sensitive"]},
    {"id": "f113", "kind": "fact", "section": "facts", "text": "Low-temperature test: EL-7 delivers 78% of room-temperature capacity at −20 °C (C/5, n=4, RUN-2608)", "concepts": ["temperature", "cycling"], "ageDays": 12, "labels": ["ip-sensitive"]},
    {"id": "f114", "kind": "fact", "section": "facts", "text": "Partner Tessaline Systems AS (tessaline.example) will use EL-7 in NaCore 2 forklift packs and funds €310,000 under contract TS-CRV-2026-07; their spec sheet needs a validated cycle life (target 3,000 cycles at 25 °C) and temperature range", "concepts": ["funding", "cycling"], "ageDays": 9},
    {"id": "f115", "kind": "fact", "section": "facts", "text": "Cells are cycled between 2.0 and 4.3 V; NVPF cells average 3.7 V on discharge; a 4.5 V overcharge abuse test is planned", "concepts": ["cells", "protocol"], "ageDays": 30},
    {"id": "f116", "kind": "fact", "section": "facts", "text": "Operando XRD beamtime costs USD 3.2k per 8-hour shift; the earliest slot is in Q1 2027", "concepts": ["instruments", "funding"], "ageDays": 11},
    {"id": "f117", "kind": "fact", "section": "facts", "text": "Separator order INV-2026-0311 from Separex sp. z o.o.: 1 200,00 zł, delivered on 18.11.2026", "concepts": ["cells", "instruments"], "ageDays": 2},
    {"id": "f118", "kind": "fact", "section": "facts", "text": "Grant NFR-2025-4471: budget NOK 4.8M, interim report due 10 Dec 2026, payments to IBAN NO54 9999 0543 212 (fictional)", "concepts": ["funding"], "ageDays": 45},
    {"id": "h185", "kind": "hypothesis", "section": "hypotheses", "text": "FEC alone explains the cycling gain; TMSB is unnecessary", "concepts": ["additive", "sei"], "ageDays": 45, "supersededBy": "h186", "labels": ["ip-sensitive"]},
    {"id": "h186", "kind": "hypothesis", "section": "hypotheses", "text": "FEC builds a NaF-rich SEI while TMSB scavenges HF; the cycling gain needs both additives", "concepts": ["additive", "sei", "literature"], "ageDays": 8, "base": 0.8, "labels": ["ip-sensitive"]},
    {"id": "h187", "kind": "hypothesis", "section": "hypotheses", "text": "The faster fade at 45 °C comes from TMSB decomposing above 40 °C and releasing gas", "concepts": ["temperature", "additive", "gassing"], "ageDays": 3, "labels": ["ip-sensitive"]},
    {"id": "h188", "kind": "hypothesis", "section": "hypotheses", "text": "Lower SEI resistance after 50 cycles predicts cycle life better than first-cycle Coulombic efficiency", "concepts": ["impedance", "sei", "stats"], "ageDays": 12, "labels": ["ip-sensitive"]},
