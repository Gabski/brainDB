    "three": "^0.187.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "storybook": "^10.6.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "4.1.12"
  }
}
